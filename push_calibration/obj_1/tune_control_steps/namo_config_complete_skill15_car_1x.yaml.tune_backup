# Complete NAMO Configuration — 1× REAL-WORLD SCALE, CAR robot variant.
#
# Identical to namo_config_complete_skill15_1x.yaml (the sphere 1× config)
# except for:
#   - planning.robot_type: "diff_drive"        — selects DiffDriveAdapter
#                                                in C++ (vs HolonomicAdapter).
#   - system.motion_primitives_file: prefix    — points at the car-flavour
#                                                primitive db.
#
# The car body (7×7 cm chassis, included from
# test_xml/little-car-modeling-package/assets/mjcf/little_car.xml) has the
# same physical footprint as the sphere, so every other geometric and
# velocity parameter stays at the sphere 1× value: robot_size 3.5 cm
# half-extent, wavefront inflation, push_velocity 0.05 m/s, control_steps_per_push
# 75 (= 0.75 s wall-clock at timestep 0.01), object friction "0 0.1 0.1".
#
# IMPORTANT: this config references data/motion_primitives_1x_car.dat which
# must be generated by running:
#   ./build/generate_motion_primitives_db \
#       --config config/namo_config_complete_skill15_car_1x.yaml \
#       --scenes-suffix 1x_car \
#       --output data/motion_primitives_1x_car.dat
# The generator emits data/motion_primitives_1x_car_{square,wide,tall}.dat.

# High-level planning configuration
planning:
  # Grid resolutions for different planning levels
  high_level_resolution: 0.01     # 1cm grid for reachability analysis
  skill_level_resolution: 0.005    # 5mm grid for detailed skill planning

  # Planning limits
  max_iterations: 10               # Maximum high-level planning iterations
  verbose: true                    # Enable verbose planning output

  # Robot type: routes NAMOEnvironment to the diff-drive adapter
  # (src/environment/namo_environment.cpp:91-109).
  robot_type: "diff_drive"

  # Robot physical properties — REAL-WORLD CM.
  # Half-extent of 7×7 cm car chassis = 3.5 cm = 0.035 m. Matches sphere.
  # Must stay in sync with robot_control real.yaml (width_cm=7, height_cm=7).
  robot_size: [0.035, 0.035]       # 7×7 robot, 3.5 cm half-extent per axis
  wavefront_edge_offset_margin: 0.01    # 1 cm — push offset past inflated boundary. Needs
                                        # to exceed tier1_inflation_margin (0.005 m) plus half
                                        # the wavefront cell size (0.002/2 m) so edge-point
                                        # cells land cleanly outside the inflated obstacle.
  robot_goal: [0.052, -0.733]      # Placeholder — overridden at runtime

  # Grid system limits
  max_bfs_queue: 100000            # Maximum BFS queue size
  max_grid_width: 2000             # Maximum grid width in cells
  max_grid_height: 2000            # Maximum grid height in cells
  max_changes: 10000               # Maximum tracked grid changes

  # Motion detection thresholds
  position_threshold: 0.00002      # ~20 µm minimum position change
  rotation_threshold: 0.001        # ~0.06 deg minimum rotation change (radians)
  small_rotation_limit: 0.05       # ~3 deg threshold for small rotations (radians)

# Selection strategy configuration
strategy:
  # Random strategy parameters
  random:
    min_goal_distance: 0.05        # 5 cm minimum
    max_goal_distance: 0.17        # 17 cm maximum
    max_goal_attempts: 100
    max_object_retries: 100

  # ML/Diffusion strategy parameters
  ml:
    zmq_endpoint: "tcp://localhost:5555"
    timeout_ms: 1000
    fallback_to_random: true

# Skill execution configuration
skill:
  # Push skill parameters
  max_push_steps: 10               # Maximum push steps per skill execution
  control_steps_per_push: 482      # 482 × 0.002 s = 0.964 s sim time per NAMO push step.
                                   # Matches real per-step wall time (26 production runtime
                                   # ticks / 27 Hz effective rate = 0.963 s). With Tier-1
                                   # chassis-vel match (sim 5.123 ≈ real 5.125 cm/s), sim
                                   # per-step displacement = 4.94 cm matches real free-running
                                   # per-step = 4.94 cm. Was 375 (= 0.75 s sim per step) which
                                   # undershot real by 25% in time/displacement.

  # Velocity-actuator control.
  # 0.05 m/s = 5 cm/s. For the diff-drive car this becomes a wheel
  # command of push_velocity / wheel_radius = 0.05 / 0.015 ≈ 3.33 rad/s,
  # well within little_car.xml's wheel ctrlrange ±25 rad/s.
  push_velocity: 0.2               # m/s — holonomic-only knob; ignored by diff-drive car (which uses push_tracker_max_speed below)
  dynamic_direction: false         # false = fix push direction at primitive-start, drive
                                   # straight in world frame for push_steps×control_steps_per_push
                                   # ticks. Path A relies on this.

  # Diff-drive push fraction cap. Calibrated 2026-05-22 via closed-loop
  # PP at PWM 0.4 on the real robot (robot_control/scripts/collect_pp_trial_real.py
  # + find_sim_fraction.py). Real median cruise = 5.125 cm/s ± 0.010; sim
  # at fraction 0.05381 cruises at 5.123 cm/s (binary-search 8 iter,
  # ε = 1×SE_real). Same value as in config/namo_config_car.yaml — keep
  # in sync. Without this line the C++ side falls back to ConfigManager's
  # default of 0.3, which makes sim ~5.6× faster than real.
  # Session: chassis_calibration/20260523_002800_pp_session/sim/search_result.json
  push_tracker_max_speed: 0.05357

  # Execution parameters
  goal_tolerance: 0.02             # 2 cm goal reaching tolerance
  check_object_collision: true     # Terminate push on object-object collision
  check_robot_trajectory_collision: false  # Terminate push if robot body hits walls during push
  stuck_check_stride: 150          # Sphere uses 30 ticks at 0.01 s = 0.3 s; match at car's 0.002 s timestep (150 × 0.002 = 0.3 s). Required so the stuck check doesn't fire before the car traverses the 1 cm standoff gap (~0.2 s at 0.05 m/s).
  controller_stuck_threshold: 5    # Allow extra slack — pre-contact phase has zero object motion which would otherwise spike the counter.
  controller_min_position_change: 0.0002  # 0.2 mm min motion per check
  controller_min_angle_change: 0.05      # ~3 deg min yaw change per check (radians)

  # Edge sampling for push approach
  points_per_face: 15              # Number of edge points per object face
  num_edge_points: 60              # = 4 × points_per_face

# Environment configuration
environment:
  max_static_objects: 30
  max_movable_objects: 30
  max_actions: 100
  max_motion_primitives: 1000
  max_planning_nodes: 10000
  log_buffer_size: 100000
  enable_logging: false
  log_directory: "logs/"

# System configuration
system:
  enable_visualization: false
  enable_profiling: false
  num_threads: 1

  # File paths — generator emits three shape-specific files derived from
  # this prefix:
  #   data/motion_primitives_1x_car_square.dat
  #   data/motion_primitives_1x_car_wide.dat
  #   data/motion_primitives_1x_car_tall.dat
  motion_primitives_file: "data/motion_primitives_1x_car.dat"
  default_scene_file: ""           # Set at runtime by the bridge

  collect_training_data: false
  training_data_directory: "training_data/"

# Wavefront planner specific configuration
wavefront_planner:
  resolution: 0.002                # 2mm grid for reachability checks
  robot_inflation: 0.0083          # Dead config — read by no code path

  max_distance: 1000               # Maximum distance value (cell count)
  diagonal_cost: 1.414             # sqrt(2)

  enable_incremental_updates: true
  cache_static_obstacles: true

  save_debug_grids: false
  debug_grid_directory: "debug_grids/"

# Motion primitive configuration
motion_primitives:
  max_push_steps: 10               # Maximum steps per primitive
